# TerraTrust AI — Environment Configuration Example
# Copy this file to .env.local for local development.
# Never put service-role keys or server secrets into browser VITE_* variables.

# Supabase API settings (browser-safe publishable credentials)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# n8n Orchestrator Webhook
VITE_N8N_WEBHOOK_URL=https://your-n8n-host/webhook/terratrust/verify

# n8n Conversational AI Assistant Webhook
VITE_N8N_ASSISTANT_WEBHOOK_URL=https://your-n8n-host/webhook/terratrust/assistant

# Server-only Gemini Developer API configuration. Never prefix these with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional local-only QA autofill. Leave blank in committed examples and production.
VITE_TEST_CITIZEN_EMAIL=
VITE_TEST_CITIZEN_PASSWORD=
VITE_TEST_GOVERNMENT_EMAIL=
VITE_TEST_GOVERNMENT_PASSWORD=
VITE_TEST_SURVEYOR_EMAIL=
VITE_TEST_SURVEYOR_PASSWORD=
VITE_TEST_BANK_EMAIL=
VITE_TEST_BANK_PASSWORD=
VITE_TEST_ADMIN_EMAIL=
VITE_TEST_ADMIN_PASSWORD=
